{
  "name": "threadhaven",
  "version": "1.0.0",
  "private": true,
  "description": "Preview and confirm public Discord discussion threads with modest defaults",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "register": "node --env-file-if-exists=.env src/register.ts",
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "safety": "node scripts/check-safety.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run safety"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@types/node": "24.19.2"
  }
}
